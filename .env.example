# Do not place actual credentials in this file.
DATABASE_URL=postgres://audit_user:CHANGE_ME@localhost:5432/audit
IAM_JWKS_URL=https://iam.example.invalid/.well-known/jwks.json
IAM_JWT_ISSUER=https://iam.example.invalid/
# Required by audit-query-api. High-entropy HMAC secret used to authenticate pagination cursors.
# Use a distinct non-versioned value per environment (32 bytes minimum recommended).
AUDIT_CURSOR_SECRET=
MESSAGE_BROKER_URL=amqp://audit:CHANGE_ME@localhost:5672/
BROKER_TOPIC_PATTERN=#
BROKER_CONSUMER_GROUP=audit-service
AUDIT_EVENTS_EXCHANGE=audit-events
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_MS=5000
LOG_LEVEL=info
SERVICE_ENV=development
PORT=8080
