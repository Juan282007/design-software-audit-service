FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/audit-query-api ./cmd/audit-query-api
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/audit-query-api /audit-query-api
USER nonroot:nonroot
ENTRYPOINT ["/audit-query-api"]
